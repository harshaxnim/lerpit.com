---
import type { LerpetteMixtape } from '../lib/lerpettes/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import LerpettesShelf from './LerpettesShelf.astro';
import LerpettePlayer from './LerpettePlayer.astro';

interface Props {
  mixtape: LerpetteMixtape;
  allMixtapes: LerpetteMixtape[];
  headerTitle?: string;
  headerSubtitle?: string;
}

const {
  mixtape,
  allMixtapes,
  headerTitle,
  headerSubtitle
} = Astro.props as Props;

// Identify by slug, not href: the landing lesson is served at '/' while the same
// lerpette keeps its canonical href in the collection listing, so comparing hrefs
// would leave the page you are reading sitting in its own "other lerpettes" shelf.
const otherLerpettes = allMixtapes.filter(
  (entry) => !(entry.slug === mixtape.slug && entry.collectionSlug === mixtape.collectionSlug)
);
---

<BaseLayout title={`${mixtape.title} · Lerpit`} description={mixtape.summary}>
  <main class="site-shell site-shell--lesson">
    <LerpettePlayer
      lerpette={mixtape}
      headerTitle={headerTitle}
      headerSubtitle={headerSubtitle}
    />
    <LerpettesShelf mixtapes={otherLerpettes} />
  </main>
</BaseLayout>
