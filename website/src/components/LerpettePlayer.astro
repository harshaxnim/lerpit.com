---
import type { LerpetteMixtape } from '@lerpit/framework/types';
import ChapterBox from './ChapterBox.astro';
import ContentProblems from './ContentProblems.astro';
import LerpetteByline from './LerpetteByline.astro';
import LerpetteStage from './LerpetteStage.astro';
import SiteHeader from './SiteHeader.astro';

interface Props {
  lerpette: LerpetteMixtape;
  headerTitle?: string;
}

const { lerpette, headerTitle } = Astro.props as Props;
const playerId = `lerpette-${(lerpette.collectionSlug ? `${lerpette.collectionSlug}-${lerpette.slug}` : lerpette.slug)
  .replace(/[^a-z0-9-]/gi, '-')
  .toLowerCase()}`;

/* The slice of each step the browser needs, as lib/player/stagePlayer.ts's ClientStep
   declares it. Anything added there has to be added here too, or it arrives undefined. */
const clientSteps = lerpette.steps.map((step) => ({
  id: step.id,
  title: step.title,
  runtimeImportKey: step.runtimeImportKey,
  runtimeStepId: step.runtimeStepId,
  assetBasePath: step.assetBasePath,
  codePath: step.codePath,
  panels: step.panels,
  caption: step.caption,
  idleStatus: step.idleStatus
}));
// The collection's colours go with the page, so a panel's randomColor(i, { from: 'collection' })
// draws in the same palette as everything else in the collection.
const playerConfig = JSON.stringify({ lessonTitle: lerpette.title, introId: lerpette.introId, steps: clientSteps, collectionColors: lerpette.collectionColors ?? [] });
// With nothing to run anywhere in the lerpette the stage has nothing to show, so it is
// not rendered at all; the player sees no panel host and leaves the page as prose.
const hasRuntime = lerpette.steps.some((step) => step.hasOwnRuntime);
---

{/* data-collection and data-lerpette tell the local editor (website/src/editor) which
    files this page is; '/' serves a lerpette whose URL does not say. */}
<section class="lerpette-player" data-lerpette-player data-collection={lerpette.collectionSlug} data-lerpette={lerpette.slug}>
  <script type="application/json" data-player-config set:html={playerConfig}></script>
  <SiteHeader title={headerTitle} />
  <LerpetteByline lerpette={lerpette} />

  <div class="lerpette-player__grid">
    <div class="lerpette-player__lesson">
      <ContentProblems problems={lerpette.problems} title="This lerpette is unfinished" />
      <ChapterBox intro id="intro" index="00" titleHtml={lerpette.titleHtml} html={lerpette.introHtml} />
      {lerpette.steps.map((step, index) => (
        <ChapterBox
          id={step.id}
          index={String(index + 1).padStart(2, '0')}
          titleHtml={step.titleHtml}
          html={step.bodyHtml}
          hasOwnRuntime={step.hasOwnRuntime}
        />
      ))}
    </div>

    {hasRuntime && <LerpetteStage playerId={playerId} />}
  </div>
</section>

<script>
  import { initLerpettePlayers } from '../lib/playerClient';

  initLerpettePlayers();
</script>
