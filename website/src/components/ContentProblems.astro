---
import type { LerpetteProblem } from '@lerpit/framework/types';
import { showsAuthoringProblems } from '../lib/content';

interface Props {
  problems: LerpetteProblem[];
  title: string;
}

const { problems, title } = Astro.props as Props;
// Every view says the page is unfinished. Only local view says why: the messages, fixes
// and paths are for the author; public view and a production build show the notice alone.
const detailed = showsAuthoringProblems();

// Problem text is written in content.ts, where paths and headings read better as
// code. Escape first, then turn the backticks into the site's inline code.
function toHtml(text: string): string {
  const escaped = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');

  return escaped.replace(/`([^`]+)`/g, '<code>$1</code>');
}
---

{
  problems.length > 0 && !detailed && (
    /* The reader's notice: the same box and words, nothing to open. */
    <div class="content-problems content-problems--brief" role="note">
      <p class="content-problems__title">
        <span class="content-problems__mark" aria-hidden="true">!</span>
        {title}
      </p>
    </div>
  )
}

{
  problems.length > 0 && detailed && (
    /* A disclosure rather than the footnotes' scripted collapse: the player returns
       early on a lerpette with no runtime, which is exactly the page most likely to
       carry problems, so the toggle has to work with no JS at all. Open from the start,
       so what is wrong is read straight away rather than counted; it folds away once
       read. */
    <details class="content-problems" open>
      <summary class="content-problems__head">
        <span class="content-problems__title">
          <span class="content-problems__mark" aria-hidden="true">!</span>
          {title}
        </span>
      </summary>

      <ul class="content-problems__list">
        {problems.map((problem) => (
          <li class="content-problems__item">
            <p class="content-problems__message" set:html={toHtml(problem.message)} />
            {problem.fix && <p class="content-problems__fix" set:html={toHtml(problem.fix)} />}
            {/* The id is what docs/authoring/problems.md is organised by. */}
            <span class="content-problems__where">{problem.where} · {problem.id}</span>
          </li>
        ))}
      </ul>
    </details>
  )
}
