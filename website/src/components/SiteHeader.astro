---
import { getCollections } from '../lib/content';
import { site } from '../site.config';
import BrandSpine from './BrandSpine.astro';

interface Props {
  title?: string;
}

const wordmark = `${site.name}${site.nameEmphasis}`;
const { title = wordmark } = Astro.props as Props;
const collections = await getCollections();
const isDefaultTitle = title === wordmark;
const base = import.meta.env.BASE_URL;

// The links are site.config.ts's. A lesson link only shows while that lesson is listed,
// so hiding a lesson never leaves the header pointing at a 404.
const listed = new Set(collections.flatMap((collection) => collection.mixtapes.map((m) => `${m.collectionSlug}/${m.slug}`)));
const links = site.headerLinks.flatMap((link) =>
  'lesson' in link
    ? listed.has(link.lesson)
      ? [{ label: link.label, href: `${base}${link.lesson}/` }]
      : []
    : [{ label: link.label, href: link.href }]
);
---

<div class="lerpette-player__bar">
  {/* The site's mark, from the sheet's top edge down to the rule. See BrandSpine. */}
  <BrandSpine />
  <div class="lerpette-player__heading">
    <h1>
      <a href={base}>
        {isDefaultTitle ? (
          <>
            {site.name}<em>{site.nameEmphasis}</em>
          </>
        ) : (
          title
        )}
      </a>
    </h1>
    <div class="lerpette-player__meta">
      <div class="lerpette-player__actions">
        {links.map((link) => (
          <a class:list={['lerpette-player__action', { 'lerpette-player__me-link': !link.href.startsWith(base) }]} href={link.href}>
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</div>
