---
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Lerpit',
  description = 'Interactive lessons on simulation, rendering, and animation.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline define:vars={{ swPath: `${import.meta.env.BASE_URL}coi-serviceworker.js` }}>
      /*
       * Cross-origin isolation, without which the in-browser C++ toolchain cannot
       * start. The dev server sends the headers itself; a static host cannot, so a
       * service worker adds them to every response instead. See the worker for why.
       *
       * The worker can only add headers to responses it serves, and it serves none
       * on the visit that installs it, so that first page has to be reloaded once.
       * A session flag spends exactly one reload, so a browser that will not keep
       * the worker shows the reader an honest error instead of looping.
       */
      (() => {
        // Blocked site data throws on access alone, so every touch is guarded.
        const RELOADED = 'lerpit:coi-reloaded';
        const flag = {
          seen: () => {
            try {
              return sessionStorage.getItem(RELOADED) === '1';
            } catch {
              return false;
            }
          },
          set: () => {
            try {
              sessionStorage.setItem(RELOADED, '1');
            } catch {}
          },
          clear: () => {
            try {
              sessionStorage.removeItem(RELOADED);
            } catch {}
          }
        };

        // A browser with no concept of isolation gains nothing from reloading.
        if (!('crossOriginIsolated' in window) || !('serviceWorker' in navigator)) {
          return;
        }

        if (window.crossOriginIsolated) {
          // Working. Drop the flag so that if the browser later evicts the worker,
          // the next visit still has its one reload to spend.
          flag.clear();
          return;
        }

        // Register on every non-isolated load, even ones that will not reload. That
        // leaves the worker installed, so the next navigation is isolated anyway.
        navigator.serviceWorker
          .register(swPath)
          .then((registration) => {
            if (flag.seen()) {
              return;
            }

            const reload = () => {
              flag.set();
              window.location.reload();
            };

            // Controlled yet not isolated means this document was served before the
            // worker took over, so its own response never got the headers. Reloading
            // is what puts the worker in front of the navigation.
            if (navigator.serviceWorker.controller || registration.active) {
              reload();
              return;
            }

            navigator.serviceWorker.addEventListener('controllerchange', reload, { once: true });
          })
          .catch(() => {
            // Private windows and blocked storage both land here. The page works; the
            // compiler does not, and says so where the reader can see it.
          });
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Ignored by Safari 26, which samples CSS instead, but still honoured by older
         iOS and by Chrome. It described a dark page; this one is paper. -->
    <meta name="theme-color" content="#fdfbf4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Mono:wght@400;600&family=Archivo+Black&family=Anton&family=Poppins:wght@900&family=Bowlby+One&display=swap"
      rel="stylesheet"
      crossorigin
    />
  </head>
  <body>
    <slot />
    <footer class="site-footer">
      <p class="site-footer__card">
        <em>Meticulously lerped by Harsha</em> (2026)
      </p>
    </footer>
  </body>
</html>
