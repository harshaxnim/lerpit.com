---
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import { getCollections, getRoutableMixtapes } from '../lib/content';
import worldMap from '../assets/world-map.svg?raw';

// The numbers come from the stats Worker (stats-worker/ in the repo root) in the browser,
// so the page stays static and the counts stay fresh. What is known at build time is what
// each path is called, so the most-read list can say "Particles" rather than a URL.
const base = import.meta.env.BASE_URL;
const pageNames: Record<string, string> = { [base]: 'The home page', [`${base}library/`]: 'The library', [`${base}analytics/`]: 'This page' };
for (const collection of await getCollections()) pageNames[`${base}${collection.slug}/`] = collection.title;
for (const mixtape of await getRoutableMixtapes()) pageNames[`${base}${mixtape.collectionSlug}/${mixtape.slug}/`] = mixtape.title;
const config = JSON.stringify({ pageNames });
---

<BaseLayout title={`Analytics · ${site.titleSuffix}`} description="Live, public traffic numbers for lerpit.com: visits, pages, referrers, countries and devices.">
  <main class="site-shell">
    <section class="sheet" data-analytics>
      <script type="application/json" data-analytics-config set:html={config}></script>
      <SiteHeader />
      <header class="collection-header library-header">
        <h2>Analytics</h2>
        <ul class="library-header__facts">
          <li><b>Last 30 days</b></li>
          <li data-stats-updated></li>
        </ul>
      </header>

      <div class="analytics">
        <p class="analytics__status" data-stats-status>Counting…</p>

        <dl class="analytics__totals">
          <div><dt>Visits, last 24 hours</dt><dd data-stat="day">—</dd></div>
          <div><dt>Visits, last 7 days</dt><dd data-stat="week">—</dd></div>
          <div><dt>Visits, last 30 days</dt><dd data-stat="month">—</dd></div>
          <div><dt>Page views, last 30 days</dt><dd data-stat="views">—</dd></div>
        </dl>

        <section>
          <h3>Visits per day</h3>
          <figure class="analytics__chart" data-stats-daily>
            <svg viewBox="0 0 600 180" preserveAspectRatio="none" aria-hidden="true">
              <line class="analytics__grid" x1="0" x2="600" y1="10" y2="10" />
              <line class="analytics__grid" x1="0" x2="600" y1="95" y2="95" />
              <path class="analytics__area" />
              <path class="analytics__line" />
              <line class="analytics__cursor" x1="0" x2="0" y1="0" y2="180" />
              <line class="analytics__base" x1="0" x2="600" y1="180" y2="180" />
            </svg>
            <span class="analytics__max" data-stats-max></span>
            <p class="analytics__tip" data-stats-tip hidden></p>
            <figcaption class="analytics__axis"><span data-stats-first></span><span data-stats-last></span></figcaption>
          </figure>
        </section>

        <section>
          <h3>Where readers are</h3>
          <div class="analytics__places">
            <figure class="analytics__map" data-stats-map>
              <Fragment set:html={worldMap} />
              <p class="analytics__tip" data-stats-tip hidden></p>
            </figure>
            <ol class="analytics__list" data-stats-list="countries"></ol>
          </div>
        </section>

        <div class="analytics__pair">
          <section>
            <h3>Most-read pages</h3>
            <ol class="analytics__list" data-stats-list="pages"></ol>
          </section>
          <section>
            <h3>Where readers come from</h3>
            <ol class="analytics__list" data-stats-list="referrers"></ol>
          </section>
        </div>

        <div class="analytics__pair">
          <section>
            <h3>Devices</h3>
            <div class="analytics__shares" data-stats-devices></div>
          </section>
          <section>
            <h3>Browsers</h3>
            <ol class="analytics__list" data-stats-list="browsers"></ol>
          </section>
        </div>

        <p class="analytics__note">
          Counted by Cloudflare Web Analytics: no cookies and no fingerprinting. A visit is counted
          on the page where a reader arrives from elsewhere; every page they open is a page view.
          Readers whose browser blocks the counter are not counted, and it does not measure how
          long a visit lasts.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const STATS_URL = 'https://stats.lerpit.com/';
  const DAYS = 30;

  type Row = { name: string; visits: number };
  type Stats = {
    updated: string;
    day: { visits: number };
    week: { visits: number };
    month: { visits: number; views: number };
    daily: { date: string; visits: number; views: number }[];
    pages?: { path: string; visits: number; views: number }[];
    referrers: Row[];
    countries: Row[];
    devices: Row[];
    browsers: Row[];
  };
  type ListRow = { label: string; count: number; title?: string };

  const root = document.querySelector<HTMLElement>('[data-analytics]')!;
  const find = <T extends Element = HTMLElement>(selector: string, within: Element = root) => within.querySelector<T>(selector)!;
  const { pageNames } = JSON.parse(find('[data-analytics-config]').textContent!) as { pageNames: Record<string, string> };

  const format = (n: number) => n.toLocaleString('en-US');
  const plural = (n: number, word: string) => `${format(n)} ${word}${n === 1 ? '' : 's'}`;
  const regions = new Intl.DisplayNames(['en'], { type: 'region' });
  // Cloudflare's codes are ISO 3166-1 alpha-2, plus T1 for Tor and XX when it cannot tell.
  const countryName = (code: string) => {
    if (code === 'T1') return 'Tor network';
    try {
      const name = regions.of(code);
      return name && name !== code ? name : 'Unknown';
    } catch {
      return 'Unknown';
    }
  };
  const DEVICES: Record<string, string> = { desktop: 'Desktop', mobile: 'Mobile', tablet: 'Tablet' };
  // ChromeMobile → Chrome Mobile
  const browserName = (name: string) => name.replace(/([a-z])([A-Z])/g, '$1 $2');
  const shortDate = (date: string) =>
    new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

  function fillList(list: HTMLElement, rows: ListRow[], unit: string) {
    if (!rows.length) {
      list.innerHTML = '<li class="is-empty">No visits recorded yet.</li>';
      return;
    }
    const most = rows[0].count;
    list.replaceChildren(
      ...rows.map((row) => {
        const item = document.createElement('li');
        item.style.setProperty('--share', `${(row.count / most) * 100}%`);
        item.title = `${row.title ?? row.label}: ${plural(row.count, unit)}`;
        const name = document.createElement('span');
        name.textContent = row.label;
        const count = document.createElement('b');
        count.textContent = format(row.count);
        item.append(name, count);
        return item;
      })
    );
  }

  // A tip that follows the pointer inside a figure: hover with a mouse, tap with a finger.
  function showTip(figure: HTMLElement, event: PointerEvent, text: string) {
    const tip = find('[data-stats-tip]', figure);
    const box = figure.getBoundingClientRect();
    tip.textContent = text;
    tip.hidden = false;
    const x = event.clientX - box.left;
    tip.style.left = `${Math.min(Math.max(x, tip.offsetWidth / 2), box.width - tip.offsetWidth / 2)}px`;
    tip.style.top = `${event.clientY - box.top}px`;
  }
  const hideTip = (figure: HTMLElement) => (find('[data-stats-tip]', figure).hidden = true);

  // Thirty days, ending today in UTC, with the days nobody came filled in as zero.
  function fillDaily(rows: Stats['daily']) {
    const byDate = new Map(rows.map((row) => [row.date, row]));
    const days = [];
    for (let i = DAYS - 1; i >= 0; i--) {
      const date = new Date(Date.now() - i * 864e5).toISOString().slice(0, 10);
      days.push({ date, visits: byDate.get(date)?.visits ?? 0, views: byDate.get(date)?.views ?? 0 });
    }

    const figure = find('[data-stats-daily]');
    const most = Math.max(1, ...days.map((day) => day.visits));
    const x = (i: number) => (i / (DAYS - 1)) * 600;
    const y = (visits: number) => 180 - (visits / most) * 170;
    const line = days.map((day, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(day.visits).toFixed(1)}`).join(' ');
    find('.analytics__line', figure).setAttribute('d', line);
    find('.analytics__area', figure).setAttribute('d', `${line} L600 180 L0 180 Z`);
    const total = days.reduce((sum, day) => sum + day.visits, 0);
    find('[data-stats-max]', figure).textContent = total ? format(most) : '';
    find('[data-stats-first]', figure).textContent = shortDate(days[0].date);
    find('[data-stats-last]', figure).textContent = shortDate(days[DAYS - 1].date);
    figure.setAttribute('aria-label', `Visits per day for the last 30 days: ${plural(total, 'visit')} in all, at most ${plural(most, 'visit')} on one day.`);

    const cursor = find('.analytics__cursor', figure);
    figure.onpointermove = figure.onpointerdown = (event) => {
      const box = figure.getBoundingClientRect();
      const i = Math.round(((event.clientX - box.left) / box.width) * (DAYS - 1));
      const day = days[Math.min(Math.max(i, 0), DAYS - 1)];
      cursor.setAttribute('x1', String(x(days.indexOf(day))));
      cursor.setAttribute('x2', String(x(days.indexOf(day))));
      cursor.classList.add('is-on');
      showTip(figure, event, `${shortDate(day.date)}: ${plural(day.visits, 'visit')}, ${plural(day.views, 'page view')}`);
    };
    figure.onpointerleave = () => {
      cursor.classList.remove('is-on');
      hideTip(figure);
    };
  }

  // Each country is shaded by the square root of its share of the top country's visits, so
  // a country with a tenth of the readers still shows clearly.
  function fillMap(rows: Row[]) {
    const figure = find('[data-stats-map]');
    const visits = new Map(rows.map((row) => [row.name, row.visits]));
    const most = Math.max(1, ...rows.map((row) => row.visits));
    for (const shape of figure.querySelectorAll<SVGPathElement>('path[data-c]')) {
      const count = visits.get(shape.dataset.c!) ?? 0;
      shape.classList.toggle('is-read', count > 0);
      shape.style.setProperty('--shade', String(0.2 + 0.8 * Math.sqrt(count / most)));
    }
    figure.querySelector('svg')!.setAttribute('aria-hidden', 'true');
    figure.onpointermove = figure.onpointerdown = (event) => {
      const code = (event.target as Element).closest<SVGPathElement>('path[data-c]')?.dataset.c;
      if (!code) return hideTip(figure);
      showTip(figure, event, `${countryName(code)}: ${plural(visits.get(code) ?? 0, 'visit')}`);
    };
    figure.onpointerleave = () => hideTip(figure);
  }

  function fillDevices(rows: Row[]) {
    const holder = find('[data-stats-devices]');
    const total = rows.reduce((sum, row) => sum + row.visits, 0);
    if (!total) {
      holder.innerHTML = '<p class="is-empty">No visits recorded yet.</p>';
      return;
    }
    const bar = document.createElement('div');
    bar.className = 'analytics__share-bar';
    const legend = document.createElement('ul');
    legend.className = 'analytics__share-legend';
    rows.forEach((row, i) => {
      const percent = Math.round((row.visits / total) * 100);
      const name = DEVICES[row.name] ?? row.name;
      const part = document.createElement('i');
      part.style.flexGrow = String(row.visits);
      part.style.setProperty('--tone', String(1 - i * 0.3));
      part.title = `${name}: ${plural(row.visits, 'visit')}`;
      const key = document.createElement('li');
      key.style.setProperty('--tone', String(1 - i * 0.3));
      key.textContent = `${name} ${percent < 1 ? 'under 1' : percent}%`;
      bar.append(part);
      legend.append(key);
    });
    holder.replaceChildren(bar, legend);
  }

  async function load() {
    const status = find('[data-stats-status]');
    try {
      const response = await fetch(STATS_URL);
      if (!response.ok) throw new Error(String(response.status));
      const stats: Stats = await response.json();

      find('[data-stat="day"]').textContent = format(stats.day.visits);
      find('[data-stat="week"]').textContent = format(stats.week.visits);
      find('[data-stat="month"]').textContent = format(stats.month.visits);
      find('[data-stat="views"]').textContent = format(stats.month.views);
      fillDaily(stats.daily);
      fillMap(stats.countries);
      fillList(find('[data-stats-list="countries"]'), stats.countries.slice(0, 8).map((row) => ({ label: countryName(row.name), count: row.visits })), 'visit');
      fillList(
        find('[data-stats-list="pages"]'),
        (stats.pages ?? []).map((page) => ({ label: pageNames[page.path] ?? page.path, title: page.path, count: page.views })),
        'page view'
      );
      fillList(find('[data-stats-list="referrers"]'), stats.referrers.map((row) => ({ label: row.name, count: row.visits })), 'visit');
      fillDevices(stats.devices);
      fillList(find('[data-stats-list="browsers"]'), stats.browsers.map((row) => ({ label: browserName(row.name), count: row.visits })), 'visit');
      find('[data-stats-updated]').textContent = `updated ${new Date(stats.updated).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}`;
      status.hidden = true;
    } catch {
      status.textContent = 'The numbers could not be loaded just now. Try again in a few minutes.';
    }
  }

  load();
</script>
