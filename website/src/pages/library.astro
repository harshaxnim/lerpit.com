---
import CollectionRow from '../components/CollectionRow.astro';
import ContentProblems from '../components/ContentProblems.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import { getCollections, getLerpetteLibrary } from '../lib/content';

const collections = await getCollections();
const { problems } = await getLerpetteLibrary();
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
---

<BaseLayout title={`Library · ${site.titleSuffix}`} description="Library of lerpettes grouped by collections.">
  <main class="site-shell">
    <section class="sheet">
      <SiteHeader />
      <header class="collection-header library-header">
        <h2>The lerpette library</h2>
        <ul class="library-header__facts">
          <li><b>{plural(collections.length, 'collection')}</b></li>
        </ul>
      </header>
      <ContentProblems problems={problems} title="The library needs attention" />

      {collections.map((collection) => (
        <CollectionRow collection={collection} />
      ))}
    </section>
  </main>
</BaseLayout>
