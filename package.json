{
  "name": "lerpit-wasm-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "npm run build:wasm && astro dev",
    "start": "npm run build:wasm && astro dev",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "npm run build:wasm && astro build",
    "clean:wasm": "find lerpettes -type d \\( -name build -o -name .build \\) -prune -exec rm -rf {} +",
    "clean:dist": "rm -rf dist",
    "clean": "npm run clean:wasm && npm run clean:dist",
    "rebuild:wasm": "npm run clean:wasm && npm run build:wasm",
    "preview": "astro preview",
    "test": "npm run test:cpp && vitest run",
    "test:js": "vitest run",
    "test:watch": "vitest",
    "test:cpp": "bash lerpettes/libs/physics/tests/cpp/run.sh"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.8",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@gameguild/emception-browser": "^4.4.0",
    "@gameguild/emception-ide": "^4.4.0",
    "@gameguild/emception-xterm": "^4.4.0",
    "@lezer/highlight": "^1.2.4",
    "@monaco-editor/react": "^4.7.0",
    "@shoelace-style/shoelace": "^2.20.1",
    "@stackblitz/sdk": "^1.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "astro": "^5.10.2",
    "katex": "^0.16.22",
    "mdast-util-to-string": "^4.0.0",
    "monaco-editor": "^0.56.0",
    "prism-code-editor": "^5.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.13.3",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sucrase": "^3.35.1",
    "three": "^0.180.0",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
